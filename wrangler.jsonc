// Cloudflare Worker for the remote MCP server (docs/specs/2026-10-26-phase-3-remote-design.md §7).
// No nodejs_compat: anything Node-only in the Worker's imports fails the build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lut-lunch-mcp",
  "main": "src/bin/worker.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Starts the history collection on time (spec §6): GitHub's own schedule runs hours late.
  "triggers": { "crons": ["30 6 * * *", "30 8 * * *", "30 10 * * *"] },
  // 60 MCP requests per minute per client (spec §5.2). If the plan doesn't offer the binding,
  // remove this block: src/worker/rate-limit.ts then counts per Worker instance instead.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
}
