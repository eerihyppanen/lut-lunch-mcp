{
  "name": "@eerihyppanen/lut-lunch-mcp",
  "version": "0.2.1",
  "description": "MCP server for LUT University Skinnarila campus lunch menus",
  "author": "eerihyppanen",
  "homepage": "https://github.com/eerihyppanen/lut-lunch-mcp#readme",
  "bugs": {
    "url": "https://github.com/eerihyppanen/lut-lunch-mcp/issues"
  },
  "type": "module",
  "bin": {
    "lut-lunch-mcp": "dist/bin/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "tsx scripts/smoke.ts",
    "collect": "tsx scripts/collect.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/bin/stdio.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "version": "tsx scripts/sync-version.ts && git add src/version.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eerihyppanen/lut-lunch-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lut",
    "lappeenranta",
    "lunch",
    "menu"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
